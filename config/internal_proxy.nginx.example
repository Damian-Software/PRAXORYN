# Demonstration only. Not a public-facing, authenticated production gateway.
# Place limit_req_zone inside the Nginx http {} context.
limit_req_zone $binary_remote_addr zone=ai_local:10m rate=2r/s;

server {
    listen 127.0.0.1:8090;
    client_max_body_size 1m;
    limit_req_status 429;

    location = /v1/models {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8080;
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
    }

    location = /v1/chat/completions {
        limit_except POST { deny all; }
        limit_req zone=ai_local burst=4 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_connect_timeout 3s;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    location / { return 404; }
}
