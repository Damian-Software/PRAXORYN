[Unit]
Description=Local AI approval workflow (one queued job)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=localai-workflow
Group=localai-workflow
WorkingDirectory=/opt/localai-workflow
EnvironmentFile=/etc/localai-workflow/runtime.env
ExecStart=/usr/bin/python3 /opt/localai-workflow/app/workflow.py run-once
StateDirectory=localai-workflow
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/localai-workflow
ReadOnlyPaths=/opt/localai-workflow/inbox

[Install]
WantedBy=multi-user.target
