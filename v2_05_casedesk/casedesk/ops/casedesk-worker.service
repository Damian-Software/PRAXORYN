[Unit]
Description=CaseDesk one-shot AI draft worker
After=network.target mariadb.service
[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/srv/casedesk
Environment=CASE_DESK_CONFIG=/etc/casedesk.ini
ExecStart=/usr/bin/php /srv/casedesk/bin/worker.php
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/var/tmp
TimeoutStartSec=135
